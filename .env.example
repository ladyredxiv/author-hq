PORT=3131

# Local sign-in. These can also be entered in Author HQ Settings.
AUTH_PASSPHRASE=
COOKIE_SECRET=

# Optional AI providers.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Optional publishing services.
BUFFER_TOKEN=
BUFFER_ORGANIZATION_ID=
EMAILOCTOPUS_API_KEY=
CO_TEACHING_CREDITS_URL=

# Optional Google Calendar connection.
GOOGLE_OAUTH_CLIENT_JSON=
GOOGLE_CALENDAR_TOKEN_JSON=
GOOGLE_CALENDAR_ID=

# Optional Amazon Ads connection. Report import works without these.
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
AMAZON_ADS_REDIRECT_URI=http://localhost:3131/integrations/amazon/callback
AMAZON_ADS_REFRESH_TOKEN=

# Optional Meta connection.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3131/integrations/meta/callback

# Optional first-run folders. They are normally managed in the app.
AUTHOR_HQ_WRITING_ROOT=
AUTHOR_HQ_EXTERNAL_WRITING_ROOT=
KNOWLEDGE_BASE_ROOT=
